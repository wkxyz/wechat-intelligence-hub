{
  "type": "function",
  "name": "wechat_query",
  "description": "Read bounded evidence from the user's authorized local WeChat index or Reader. No reports, state changes or message sending. Honor coverage and ask on ambiguous chats.",
  "parameters": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "enum": [
          "status",
          "search",
          "history",
          "context",
          "person",
          "topic",
          "reply",
          "tasks"
        ]
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "keywords": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "maxItems": 5
      },
      "chat": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "since": {
        "type": "string",
        "description": "ISO 8601 inclusive start, preferably with timezone"
      },
      "until": {
        "type": "string",
        "description": "ISO 8601 exclusive end, preferably with timezone"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 30
      },
      "max_text_chars": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4000,
        "default": 2000
      },
      "message_id": {
        "type": "integer",
        "minimum": 1,
        "description": "Local index message ID only, for context"
      },
      "radius": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10,
        "default": 2
      },
      "live": {
        "type": "boolean",
        "default": false,
        "description": "Refresh from existing Reader; only search/topic/history/person/reply"
      }
    },
    "required": [
      "command"
    ],
    "additionalProperties": false
  }
}
